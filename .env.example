# ==============================================================================
# The Solutions BD - Environment Configuration Template
# ==============================================================================

# Timezone & Localization
TZ=Asia/Dhaka
DEFAULT_CURRENCY=BDT
DEFAULT_LOCALE=en-BD

# Apps Ports & Hosts
PORT=4000
API_PORT=4000
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# Set to 127.0.0.1 in production so that only the reverse proxy can reach the API
# API_BIND_HOST=127.0.0.1

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# PostgreSQL Connection (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bd_tech_ecommerce"

# Redis Connection
REDIS_URL=redis://localhost:6379

# Typesense Search Engine
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=solusation_dev_typesense_key_2026

# Authentication & Security
# Production refuses to start with placeholders. Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_2026
# Secure cookies need HTTPS. Set to false only while the site is still on plain HTTP.
# COOKIE_SECURE=true
# Allowed browser origins, comma separated (storefront and admin URLs are always included)
# CORS_ORIGINS=https://thesolutionsbd.com,https://www.thesolutionsbd.com,https://admin.thesolutionsbd.com
# Swagger defaults to on in development and off in production
# ENABLE_SWAGGER=false

# Staff accounts, used only by: pnpm --filter @solusation/api seed:admins
# SEED_ADMIN_PASSWORD=
# SEED_SEO_PASSWORD=
# SEED_RESET_PASSWORDS=false

# Email (required in production for verification and password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=The Solutions BD <thesolutionsbd@gmail.com>
# ADMIN_NOTIFY_EMAIL=thesolutionsbd@gmail.com

# bKash Tokenized Checkout. The gateway stays off until real credentials from bKash are set;
# customers can still pay by Send Money and submit a TrxID for staff to check.
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_MERCHANT_NUMBER=01922-730343
